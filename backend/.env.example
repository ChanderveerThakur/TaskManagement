# Django Settings
SECRET_KEY=your-production-secret-key-change-me
DEBUG=False

# Database (PostgreSQL URL e.g. from Neon, Render Postgres, Supabase)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# Hosts and CORS
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CORS_ALLOWED_ORIGINS=https://your-frontend-app.onrender.com,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,http://localhost:5173
